# Conexão PostgreSQL (o docker-compose da raiz já sobe um banco compatível)
DATABASE_URL="postgresql://rinq:rinq@localhost:5432/rinq?schema=public"

# HTTP
PORT=3333
HOST=0.0.0.0

# Temporada ativa servida em GET /season — HUMAN_MMA | ROBOT_ROOSTER
ACTIVE_SEASON=HUMAN_MMA
SEASON_LABEL="Temporada 1 — Rinq MMA"
SEASON_ENDS_AT=2026-09-30T23:59:59.000Z

# Canal EAS Update correspondente à temporada (usado pelo app para OTA)
EAS_CHANNEL=season-mma

# Autenticação
JWT_SECRET=troque-esta-chave-em-producao
ADMIN_EMAIL=admin@rinq.app
ADMIN_PASSWORD=admin12345

# Mantido apenas para compatibilidade com configurações antigas
DEMO_USER_EMAIL=demo@rinq.app
