{
  "name": "rinq-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "ota:publish:mma": "eas update --branch season-mma --message \"Temporada MMA\"",
    "ota:publish:robot": "eas update --branch season-robot --message \"Temporada Galos-Robo\"",
    "ota:switch:mma": "eas channel:edit production --branch season-mma",
    "ota:switch:robot": "eas channel:edit production --branch season-robot"
  },
  "dependencies": {
    "expo": "^57",
    "expo-constants": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
