{
  "name": "rinq-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "ota:publish:mma": "eas update --branch season-mma --message \"Temporada MMA\"",
    "ota:publish:robot": "eas update --branch season-robot --message \"Temporada Galos-Robo\"",
    "ota:switch:mma": "eas channel:edit production --branch season-mma",
    "ota:switch:robot": "eas channel:edit production --branch season-robot"
  },
  "dependencies": {
    "expo": "^58.0.23",
    "expo-constants": "~58.0.15",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
