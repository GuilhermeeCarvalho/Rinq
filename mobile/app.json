{
  "expo": {
    "name": "Rinq",
    "slug": "rinq-app",
    "version": "1.0.0",
    "scheme": "rinq",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/fae363c8-eeb9-4838-8214-6783de3d2c1e"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rinq.mobile"
    },
    "android": {
      "package": "app.rinq.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0D"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fae363c8-eeb9-4838-8214-6783de3d2c1e"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store"
    ],
    "owner": "guilhermeecarvalho"
  }
}
